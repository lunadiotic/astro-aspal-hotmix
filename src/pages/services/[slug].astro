---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

// Generate static routes at build time for all markdown items in 'services' collection
export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout title={`${entry.data.title} | CV. Rassya Tunggal Mandiri`} description={entry.data.description}>
  <Header />

  <main class="flex-grow pt-24 pb-20 bg-brand-light">
    <article class="max-w-3xl mx-auto px-6 sm:px-12 py-12 bg-white rounded-[2.5rem] shadow-antigravity border border-slate-100/60">
      <!-- Article Header -->
      <div class="mb-8 text-left">
        <a href="/#layanan" class="inline-flex items-center gap-1.5 text-xs font-bold text-primary hover:text-primary-hover uppercase tracking-widest mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Kembali ke Layanan
        </a>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-brand-dark mb-4 leading-tight">
          {entry.data.title}
        </h1>
        <p class="text-slate-500 font-medium text-sm sm:text-base leading-relaxed">
          {entry.data.description}
        </p>
        <div class="w-full h-px bg-slate-100 my-8"></div>
      </div>

      <!-- Rendered Markdown Body Content -->
      <div class="prose prose-slate max-w-none text-slate-600 leading-relaxed font-medium text-sm sm:text-base text-left">
        <Content />
      </div>

      <!-- Action Footer Box inside Service Article -->
      <div class="mt-12 pt-8 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-6">
        <div class="text-left">
          <span class="block text-sm sm:text-base font-extrabold text-brand-dark">Butuh Jasa Ini Sekarang?</span>
          <span class="block text-xs text-slate-400 font-medium mt-0.5">Dapatkan survei lokasi & estimasi biaya gratis</span>
        </div>
        <a 
          href={`https://wa.me/6281234567890?text=Halo%20CV.%20Rassya%20Tunggal%20Mandiri,%20saya%20tertarik%20dengan%20layanan%20${encodeURIComponent(entry.data.title)}.%20Boleh%20minta%20info%20lebih%20lanjut?`}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-secondary hover:bg-emerald-600 text-white font-extrabold py-3.5 px-8 rounded-2xl shadow-glow-secondary hover:-translate-y-0.5 transition-all duration-300 text-[14px]"
        >
          Hubungi via WhatsApp
        </a>
      </div>
    </article>
  </main>

  <Footer />
</Layout>

<style is:global>
  /* Base content typography style support inside dynamic markdown injection */
  .prose h3 {
    font-size: 1.25rem;
    font-weight: 800;
    color: rgb(var(--color-brand-dark));
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
  .prose p {
    margin-bottom: 1.25rem;
    line-height: 1.7;
  }
  .prose ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .prose li {
    margin-bottom: 0.5rem;
  }
</style>
