---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

// Generate static routes at build time for all markdown items in 'blog' collection
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

// Format date to local Indonesian locale
function formatDate(dateStr: string) {
  const options: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'long', day: 'numeric' };
  return new Date(dateStr).toLocaleDateString('id-ID', options);
}
---

<Layout title={`${entry.data.title} | CV. Rassya Tunggal Mandiri`} description={entry.data.description}>
  <Header />

  <main class="flex-grow pt-24 pb-20 bg-brand-light">
    <article class="max-w-3xl mx-auto px-6 sm:px-12 py-12 bg-white rounded-[2.5rem] shadow-antigravity border border-slate-100/60">
      <!-- Article Header -->
      <div class="mb-8 text-left">
        <a href="/#artikel" class="inline-flex items-center gap-1.5 text-xs font-bold text-primary hover:text-primary-hover uppercase tracking-widest mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Kembali ke Artikel
        </a>
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-brand-dark mb-4 leading-tight">
          {entry.data.title}
        </h1>
        
        <!-- Post Meta Metadata -->
        <div class="flex items-center gap-4 text-xs font-semibold text-slate-400 mt-4">
          <span class="flex items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            {formatDate(entry.data.publishDate)}
          </span>
          <span class="flex items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            {entry.data.author}
          </span>
        </div>

        <div class="w-full h-px bg-slate-100 my-8"></div>
      </div>

      <!-- Feature Cover Image -->
      {entry.data.image && (
        <div class="w-full aspect-[16/9] rounded-2xl overflow-hidden mb-10 shadow-md">
          <img 
            src={entry.data.image} 
            alt={entry.data.title} 
            class="w-full h-full object-cover"
            loading="eager"
            width="672"
            height="378"
          />
        </div>
      )}

      <!-- Rendered Markdown Body Content -->
      <div class="prose prose-slate max-w-none text-slate-600 leading-relaxed font-medium text-sm sm:text-base text-left">
        <Content />
      </div>

      <!-- CTA Box -->
      <div class="mt-12 pt-8 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-6 bg-slate-50 p-8 rounded-3xl">
        <div class="text-left">
          <span class="block text-sm sm:text-base font-extrabold text-brand-dark">Butuh Jasa Pengaspalan Jalan?</span>
          <span class="block text-xs text-slate-400 font-medium mt-0.5">Hubungi kami untuk penawaran harga & survei lokasi gratis</span>
        </div>
        <a 
          href="https://wa.me/6285210805708?text=Halo%20CV.%20Rassya%20Tunggal%20Mandiri,%20saya%20membaca%20artikel%20Anda%20dan%20tertarik%20dengan%20jasa%20pengaspalan.%20Bisa%20bantu%20estimasi%20biaya?"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-secondary hover:bg-emerald-600 text-white font-extrabold py-3.5 px-8 rounded-2xl shadow-glow-secondary hover:-translate-y-0.5 transition-all duration-300 text-[14px]"
        >
          Hubungi WhatsApp
        </a>
      </div>
    </article>
  </main>

  <Footer />
</Layout>

<style is:global>
  /* Markdown blog content typography styles */
  .prose h3 {
    font-size: 1.25rem;
    font-weight: 800;
    color: rgb(var(--color-brand-dark));
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
  .prose p {
    margin-bottom: 1.25rem;
    line-height: 1.75;
  }
  .prose ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .prose li {
    margin-bottom: 0.5rem;
  }
  .prose ol {
    list-style-type: decimal;
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }
</style>
