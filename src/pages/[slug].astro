---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Generate static routes at build time for all markdown items in 'wilayah' collection
export async function getStaticPaths() {
  const regions = await getCollection('wilayah');
  return regions.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const pageTitle = entry.data.metaTitle || `${entry.data.title} | CV. Rassya Tunggal Mandiri`;
---

<Layout title={pageTitle} description={entry.data.description}>
  <Header />

  <main class="flex-grow pt-24 pb-20 bg-brand-light">
    <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Left / Main Article Column -->
      <article class="lg:col-span-8 bg-white p-8 sm:p-12 rounded-[2.5rem] shadow-antigravity border border-slate-100/60 text-left">
        <!-- Breadcrumb / Back Link -->
        <a href="/" class="inline-flex items-center gap-1.5 text-xs font-bold text-primary hover:text-primary-hover uppercase tracking-widest mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Kembali ke Beranda
        </a>

        <!-- Headline -->
        <h1 class="text-3xl sm:text-4xl font-extrabold text-brand-dark mb-4 leading-tight">
          {entry.data.title}
        </h1>
        <p class="text-slate-500 font-medium text-sm sm:text-base leading-relaxed">
          {entry.data.description}
        </p>
        
        <div class="w-full h-px bg-slate-100 my-8"></div>

        <!-- Rendered Markdown Body Content -->
        <div class="prose prose-slate max-w-none text-slate-600 leading-relaxed font-medium text-sm sm:text-base">
          <Content />
        </div>
      </article>

      <!-- Right Column Sidebar -->
      <aside class="lg:col-span-4 flex flex-col gap-8 text-left">
        <!-- Sidebar Card: Popular Services in Region -->
        {entry.data.popularServices && entry.data.popularServices.length > 0 && (
          <div class="bg-white p-8 rounded-[2.5rem] shadow-antigravity border border-slate-100/60">
            <h3 class="text-lg font-extrabold text-brand-dark mb-4 pb-3 border-b border-slate-100">
              Layanan Populer di Sini
            </h3>
            <ul class="flex flex-col gap-3">
              {entry.data.popularServices.map((serviceName: string) => (
                <li class="flex items-start gap-2.5 text-slate-600 font-medium text-[14px]">
                  <span class="w-5 h-5 rounded-md bg-secondary/10 flex items-center justify-center text-secondary shrink-0 mt-0.5">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                  </span>
                  <span>{serviceName}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Sidebar Card: Quick WA Contact -->
        <div class="bg-primary p-8 rounded-[2.5rem] shadow-glow-primary text-white relative overflow-hidden">
          <!-- Decorative shape -->
          <div class="absolute -right-10 -bottom-10 w-40 h-40 bg-white/10 rounded-full blur-xl"></div>
          
          <h3 class="text-xl font-extrabold mb-3 relative z-10">Hubungi Kami Sekarang</h3>
          <p class="text-white/80 font-medium text-[13px] leading-relaxed mb-6 relative z-10">
            Dapatkan estimasi biaya pengerjaan aspal gratis dan konsultasikan kebutuhan jalan Anda langsung dengan tim ahli kami di wilayah Anda.
          </p>
          <a 
            href={`https://wa.me/6281234567890?text=Halo%20CV.%20Rassya%20Tunggal%20Mandiri,%20saya%20ingin%20berkonsultasi%20jasa%20pengaspalan%20di%20wilayah%20${encodeURIComponent(entry.data.title)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="block w-full text-center bg-white hover:bg-slate-50 text-primary font-extrabold py-3.5 px-6 rounded-2xl shadow-lg hover:-translate-y-0.5 transition-all duration-300 text-[14px] relative z-10"
          >
            Hubungi WhatsApp (Bpk. Rahman)
          </a>
        </div>
      </aside>

    </div>
  </main>

  <Footer />
</Layout>

<style is:global>
  /* Markdown styling context inside dynamic region paths */
  .prose h3 {
    font-size: 1.25rem;
    font-weight: 800;
    color: rgb(var(--color-brand-dark));
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
  .prose p {
    margin-bottom: 1.25rem;
    line-height: 1.7;
  }
  .prose ol {
    list-style-type: decimal;
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .prose li {
    margin-bottom: 0.5rem;
  }
</style>
